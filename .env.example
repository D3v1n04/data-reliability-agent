# Administrative connection used only by Alembic migrations
MIGRATION_DATABASE_URL=postgresql://dra_admin:CHANGE_ME@YOUR_CLUSTER_HOST:26257/data_reliability?sslmode=verify-full

# Restricted runtime connection used by FastAPI
DATABASE_URL=postgresql://dra_app:CHANGE_ME@YOUR_CLUSTER_HOST:26257/data_reliability?sslmode=verify-full

ENVIRONMENT=local
AWS_PROFILE=data-reliability-agent
AWS_REGION=us-east-1

BEDROCK_TEXT_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=256

SIMILAR_INCIDENT_LIMIT=5

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

BEDROCK_CONNECT_TIMEOUT_SECONDS=3
BEDROCK_READ_TIMEOUT_SECONDS=20
AWS_MAX_ATTEMPTS=2

DATABASE_POOL_SIZE=1
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_POOL_RECYCLE_SECONDS=300
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=10000

LOG_LEVEL=INFO
METRICS_NAMESPACE=DataReliabilityAgent

# Production uses this instead of DATABASE_URL. The Lambda execution role
# retrieves and decrypts the SSM SecureString at cold start.
# DATABASE_URL_SSM_PARAMETER=/data-reliability-agent/production/database-url
